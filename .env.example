# groq (free key: https://console.groq.com/keys) or ollama (local, no key)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-120b
# Optional: a different model for the self-check review (e.g. openai/gpt-oss-20b). Empty = same model.
REVIEW_MODEL=
# low/medium/high for reasoning models like gpt-oss; leave empty for non-reasoning models
LLM_REASONING_EFFORT=low

# For Ollama instead:
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# LLM_REASONING_EFFORT=

LLM_TEMPERATURE=0.3
LLM_JSON_RETRIES=2
MAX_REVISIONS=1
# sections drafted concurrently; keep low on the Groq free tier
MAX_PARALLEL_TASKS=3
OUTPUT_DIR=outputs
